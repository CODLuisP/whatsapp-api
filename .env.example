# =============================================
# CONFIGURACIÓN DEL SERVIDOR
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# API KEY para proteger los endpoints (opcional)
# =============================================
API_KEY=tu_clave_secreta_aqui

# =============================================
# CONFIGURACIÓN DE WHATSAPP
# =============================================
# Carpeta donde se guardan los archivos de sesión
SESSION_DIR=./sessions

# Prefijo del nombre de sesión
SESSION_NAME=whatsapp_session

# =============================================
# CONFIGURACIÓN DE COLA DE MENSAJES
# =============================================
# Delay mínimo entre mensajes en milisegundos
QUEUE_MIN_DELAY=2000

# Delay máximo entre mensajes en milisegundos
QUEUE_MAX_DELAY=5000

# =============================================
# BASE DE DATOS
# =============================================
DATABASE_PATH=./data/whatsapp.db

# =============================================
# ARCHIVOS SUBIDOS (imágenes, documentos)
# =============================================
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=50

# =============================================
# LOGS
# =============================================
LOG_LEVEL=info
LOG_DIR=./logs
